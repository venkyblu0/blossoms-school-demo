{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "The Blossoms School — website demo (Design 1 · Heritage)",
		"author": "Scholr Services"
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": false,
	"steps": [
		{
			"step": "installTheme",
			"themeData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/venkyblu0/blossoms-school-demo/main/blossoms-heritage.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/venkyblu0/blossoms-school-demo/main/blossoms-site-content.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "updateUserMeta",
			"meta": {
				"show_admin_bar_front": "false"
			},
			"userId": 1
		}
	]
}